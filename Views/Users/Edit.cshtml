@model Holistic_Hiking.Models.Entities.User

@{
    ViewData["Title"] = "Edit Profile";
    ViewData["ActivePage"] = "EditProfile";
    Layout = "/Areas/Identity/Pages/Account/Manage/_Layout.cshtml";
}

<h2 class="h4 mb-1">Edit profile</h2>
<p class="text-body-secondary mb-4">This is what other hikers see on your public profile.</p>

<form asp-controller="Users" asp-action="Edit" method="post" class="col-lg-8 px-0">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

    <div class="row g-3 mb-3">
        <div class="col-sm-6">
            <label asp-for="FirstName" class="form-label">First name</label>
            <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
            <span asp-validation-for="FirstName" class="text-danger small"></span>
        </div>
        <div class="col-sm-6">
            <label asp-for="LastName" class="form-label">Last name <span class="text-body-secondary">(optional)</span></label>
            <input asp-for="LastName" class="form-control" autocomplete="family-name" />
            <span asp-validation-for="LastName" class="text-danger small"></span>
        </div>
    </div>

    <div class="mb-4">
        <label asp-for="UserBio" class="form-label">Bio <span class="text-body-secondary">(optional)</span></label>
        <textarea asp-for="UserBio" class="form-control" rows="5" maxlength="1000"
                  placeholder="Tell other hikers a little about yourself..."></textarea>
        <span asp-validation-for="UserBio" class="text-danger small"></span>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <button type="submit" class="btn btn-primary">Save changes</button>
        <a asp-controller="Users" asp-action="Profile" class="btn btn-link">Cancel</a>
    </div>
</form>

@* Needed for client-side validation:
 * https://learn.microsoft.com/en-us/aspnet/core/mvc/models/validation?view=aspnetcore-10.0#client-side-validation
*@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
