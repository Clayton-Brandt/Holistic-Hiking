@model Holistic_Hiking.Models.Entities.User

@{
    ViewData["Title"] = "My Dashboard";
    var displayName = string.IsNullOrWhiteSpace(Model.FirstName) ? "hiker" : Model.FirstName;
}

<div class="container py-4">
    <!--- Header --->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="mb-1">Welcome, @displayName!</h1>
            <p class="text-body-secondary mb-0">Manage your Holistic Hiking profile and activity</p>
        </div>
        <a asp-controller="Trails" asp-action="Index" class="btn btn-primary">
            <i class="bi bi-compass" aria-hidden="true"></i> Browse Trails
        </a>
    </div>

    <div class="row g-4">
        <!--- Profile --->
        <aside class="col-lg-4">
            <div class="card">
                <div class="card-body">
                    <h2 class="card-title h4">My Profile</h2>
                    <dl class="row trail-details mb-3">
                        <dt class="col-5">Name</dt>
                        <dd class="col-7">@Model.FirstName @Model.LastName</dd>

                        <dt class="col-5">Email</dt>
                        <dd class="col-7 text-break">@Model.Email</dd>

                        <dt class="col-5">Member since</dt>
                        <dd class="col-7 mb-0">@Model.JoinDate.ToString("MMMM d, yyyy")</dd>
                    </dl>
                    <div class="d-grid gap-2">
                        <a asp-controller="Users" asp-action="Profile" class="btn btn-secondary">View Public Profile</a>
                        <a asp-controller="Users" asp-action="Edit" class="btn btn-link">Edit Profile</a>
                    </div>
                </div>
            </div>

            <div class="card mt-4">
                  <div class="card-body">
                    <h2 class="card-title h4">My Activity</h2>
                    <div class="row text-center">
                        <div class="col">
                            <div class="stat-value">@Model.SavedTrails.Count</div>
                            <div class="text-body-secondary small">Saved trails</div>
                        </div>
                        <div class="col">
                            <div class="stat-value">@Model.Comments.Count</div>
                            <div class="text-body-secondary small">Comments</div>
                        </div>
                    </div>
                </div>
            </div>
        </aside>

        <div class="col-lg-8">
            <!--- Saved Trails --->
            <section class="card">
                <div class="card-body">
                    <h2 id="saved-heading" class="card-title h4">My Saved Trails</h2>
                    @if (Model.SavedTrails.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var saved in Model.SavedTrails.OrderByDescending(s => s.SavedAt))
                            {
                                <li
                                    class="list-group-item px-0 d-flex flex-wrap justify-content-between align-items-center gap-2">
                                    <div>
                                        <a asp-controller="Trails" asp-action="Details" asp-route-id="@saved.TrailId"
                                            class="fw-semibold">
                                            @saved.Trail.Name
                                        </a>
                                        <div class="text-body-secondary small">
                                            @saved.Trail.Location &middot; @saved.Trail.Difficulty &middot; @saved.Trail.Length
                                            miles
                                        </div>
                                    </div>
                                    <form asp-controller="SavedTrails" asp-action="Remove" method="post">
                                        <input type="hidden" name="trailId" value="@saved.TrailId" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm">
                                            <i class="bi bi-bookmark-x" aria-hidden="true"></i> Remove
                                        </button>
                                    </form>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-body-secondary mb-0">
                            You haven't saved any trails yet.
                            <a asp-controller="Trails" asp-action="Index">Find one to save.</a>
                        </p>
                    }
                </div>
            </section>

            <!--- Recent Comments --->
            <section class="card mt-4">
                <div class="card-body">
                    <h2 id="comments-heading" class="card-title h4">Recent Comments</h2>
                    @if (Model.Comments.Any())
                    {
                        <ul class="list-unstyled mb-0">
                            @foreach (var comment in Model.Comments.OrderByDescending(c => c.CreatedAt).Take(5))
                            {
                                <li class="comment">
                                    <p class="comment-text mb-1">@comment.Text</p>
                                    <small class="text-body-secondary">
                                        @comment.CreatedAt.ToString("MMMM d, yyyy") &middot;
                                        <a asp-controller="Trails" asp-action="Details" asp-route-id="@comment.TrailId" asp-fragment="comments">
                                            @(comment.Trail?.Name ?? "View trail")
                                        </a>
                                    </small>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-body-secondary mb-0">You haven't commented on any trails yet.</p>
                    }
                </div>
            </section>

            <!--- Ratings (Not Implemented Yet) --->
            <section class="card mt-4">
                <div class="card-body">
                    <h2 id="ratings-heading" class="card-title h4">My Trail Ratings</h2>
                    <p class="text-body-secondary mb-0">Trail ratings are coming soon!</p>
                </div>
            </section>
        </div>
    </div>
</div>
