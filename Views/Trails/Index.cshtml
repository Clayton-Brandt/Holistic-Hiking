@model IEnumerable<Trail>

@{
    ViewData["Title"] = "Browse Trails";
    var placeholderImage = "/images/trail-placeholder.jpg";
}

<div class="container py-4">
    <h1 class="mb-4">Browse Trails</h1>
    <div class="row">
        <!--- This is the Search/Filter sidebar --->
        <aside class="col-lg-3">
            <div class="card">
                <div class="card-body d-grid gap-3">
                    <!--- Search Name --->
                    <input type="text" class="form-control" placeholder="Search trails by name...">
                    <!--- Filter Difficulty --->
                    <select class="form-select">
                        <option value="">Difficulty</option>
                        <option>Easy</option>
                        <option>Moderate</option>
                        <option>Hard</option>
                    </select>
                    <!--- Filter Length --->
                    <select class="form-select">
                        <option value="">Length</option>
                        <option>Less than 5 miles</option>
                        <option>5-10 miles</option>
                        <option>greater than 10 miles</option>
                    </select>
                    <!--- Filter Rating --->
                    <select class="form-select">
                        <option value="">Rating</option>
                        <option>5 Stars</option>
                        <option>4 Stars</option>
                        <option>3 Stars</option>
                        <option>2 Stars</option>
                        <option>1 Stars</option>
                    </select>
                </div>
            </div>
        </aside>
        <!--- The Trail Listings themselves -->
        <section class="col-lg-9 d-grid gap-4">
            @foreach (var trail in Model)
            {
                <div class="card overflow-hidden">
                    <div class="row g-0">
                        <div class="col-md-4 position-relative">
                            <img src="@(string.IsNullOrWhiteSpace(trail.ImageUrl) ? placeholderImage : trail.ImageUrl)"
                                 alt="@trail.Name" class="trail-image" />
                        </div>
                        <div class="col-md-8">
                            <div class="card-body">
                                <h2 class="card-title h4">@trail.Name</h2>

                                <dl class="row trail-details mb-2">
                                    <dt class="col-sm-3">Location</dt>
                                    <dd class="col-sm-9">@trail.Location</dd>

                                    <dt class="col-sm-3">Length</dt>
                                    <dd class="col-sm-9">@trail.Length miles</dd>

                                    <dt class="col-sm-3">Difficulty</dt>
                                    <dd class="col-sm-9">@trail.Difficulty</dd>

                                    <dt class="col-sm-3">Rating</dt>
                                    <dd class="col-sm-9">@(trail.Rating > 0 ? $"{trail.Rating} / 5" : "Not yet rated")</dd>
                                
                                </dl>

                                <p class="card-text">@trail.Description</p>
                                <div class="text-end">
                                    <a asp-action="Details" asp-route-id="@trail.TrailId" class="btn btn-primary btn-sm">View Trail</a>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            }
        </section>
    </div>

</div>