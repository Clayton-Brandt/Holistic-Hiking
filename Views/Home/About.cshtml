@{
    ViewData["Title"] = "About Us";
    var team = new[] { "Clayton Brandt", "Terysa Brewer", "Luke Bunting", "Nathan McMichael", "William Pardue" };
}

<!--- Mission --->
<section class="about-hero" aria-labelledby="mission-heading">
    <div class="about-hero-content mx-auto">
        <h1 class="visually-hidden">@ViewData["Title"]</h1>
        <h2 id="mission-heading" class="mb-3">Our Mission</h2>
        <p class="lead mb-0">Help more people enjoy the great outdoors by providing free, convenient access to hiking trail information.</p>
    </div>
</section>

<!--- Team --->
<section class="container py-5" aria-labelledby="team-heading">
    <h2 id="team-heading" class="text-center mb-4">Our Team</h2>
    <ul class="row g-4 list-unstyled justify-content-center mb-0">
        @foreach (var name in team)
        {
            var initials = string.Concat(name.Split(' ').Select(part => part[0]));
            <li class="col-6 col-md-4 col-lg-2">
                <div class="card h-100 text-center">
                    <div class="card-body">
                        <div class="profile-avatar mb-3" aria-hidden="true">@initials</div>
                        <p class="fw-semibold mb-0">@name</p>
                    </div>
                </div>
            </li>
        }
    </ul>
</section>
