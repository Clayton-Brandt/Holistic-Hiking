@{
    ViewData["Title"] = "Holistic Hiking";
}

<div class="homepage-background">
    <div class="hero">
        <h1>Holistic Hiking</h1>

        <h2>Find the perfect hiking trail based on your preferences.</h2>

        <p>
            Discover hiking trails that match your preferences.
            Whether you're a beginner or an experienced hiker, Holistic Hiking helps you
            find the perfect trail for your next adventure.
        </p>

        <div class="hero-buttons">
            <a asp-controller="Trails" asp-action="Index" class="btn btn-primary btn-lg">
                Browse Trails
            </a>

            <form asp-controller="Trails" asp-action="Index" method="get">
                <input type="text" name="searchString" class="form-control form-control-lg" placeholder="Search by Name"
                       aria-label="Search trails by name" />
            </form>
        </div>
    </div>
</div>
