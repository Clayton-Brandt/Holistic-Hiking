<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"]</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Holistic-Hiking.styles.css" asp-append-version="true" />
</head>

<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar site-navbar">
            <div class="container-fluid nav-container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.png" alt="Holistic Hiking Home" class="navbar-logo" />
                </a>
                @* Theme switcher taken from the tutorial: https://albertoroura.com/building-a-theme-switcher-for-bootstrap/ *@
                <div class="mode-switch">
                    <button title="Use dark mode" id="dark" class="btn btn-sm">
                        <i class="bi bi-moon"></i>
                    </button>
                    <button title="Use light mode" id="light" class="btn btn-sm">
                        <i class="bi bi-sun"></i>
                    </button>
                    <button title="Use system preferred mode" id="system" class="btn btn-sm">
                        <i class="bi bi-display"></i>
                    </button>
                </div>


                <div class="ms-auto">
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="d-flex flex-column flex-grow-1">
        @RenderBody()
    </main>

    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/theme.js" asp-append-version="true" defer></script>
</body>

</html>
