@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="auth-background">
    <div class="card auth-card">
        <div class="card-body p-4 p-md-5">
            <img src="~/images/logo.png" alt="" class="auth-logo" />
            <h1 class="h3 text-center mb-1">Welcome back</h1>
            <p class="text-center text-body-secondary mb-4">Log in to save trails and leave comments.</p>

            <form id="account" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <label asp-for="Input.Email">Email</label>
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Password" />
                    <label asp-for="Input.Password">Password</label>
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>

                <div class="form-check mb-3">
                    <input class="form-check-input" asp-for="Input.RememberMe" />
                    <label class="form-check-label" asp-for="Input.RememberMe">Remember me</label>
                </div>

                <button id="login-submit" type="submit" class="btn btn-primary btn-lg w-100">Log in</button>
            </form>

            <p class="text-center mt-4 mb-0">
                New here?
                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Create an account</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
