@{
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="mb-1">Account Settings</h1>
            <p class="text-body-secondary mb-0">Manage your profile, password and account data.</p>
        </div>
        <a asp-area="" asp-controller="Users" asp-action="Dashboard" class="btn btn-link px-0">
            <i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Dashboard
        </a>
    </div>

    <div class="row g-4">
        <aside class="col-lg-3">
            <nav class="card" aria-label="Account settings">
                <div class="card-body p-2">
                    <partial name="/Areas/Identity/Pages/Account/Manage/_ManageNav.cshtml" />
                </div>
            </nav>
        </aside>
        <div class="col-lg-9">
            <div class="card">
                <div class="card-body p-4">
                    @RenderBody()
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
